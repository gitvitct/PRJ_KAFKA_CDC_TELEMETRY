{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "CDC Messages Processed / sec",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(cdc_messages_processed_total[1m])", "legendFormat": "processed/s"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "CDC Messages Failed / sec",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(cdc_messages_failed_total[1m])", "legendFormat": "failed/s"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "CDC Processing Duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(cdc_processing_duration_milliseconds_bucket[5m])) by (le))", "legendFormat": "p95 ms"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "stat",
      "title": "Messages Processed",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(cdc_messages_processed_total)", "legendFormat": "processed"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ],
  "schemaVersion": 39,
  "tags": ["cdc", "kafka", "opentelemetry"],
  "title": "CDC - OpenTelemetry Observability",
  "uid": "cdc-otel-observability",
  "version": 1
}
